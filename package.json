{
  "name": "mcp-flightcheck",
  "version": "0.1.0",
  "description": "CI-grade conformance and reliability testing for MCP servers. Vet your server before you ship it.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "testing",
    "conformance",
    "ci",
    "reliability",
    "lint"
  ],
  "license": "MIT",
  "author": "Ofir Pardo",
  "type": "module",
  "bin": {
    "mcp-flightcheck": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "picocolors": "^1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
